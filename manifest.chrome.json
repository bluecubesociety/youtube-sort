{
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "src/browser-polyfill.min.js",
        "src/content.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "64": "icons/icon-64.png"
    },
    "default_title": "YouTube Sort",
    "default_popup": "src/popup.html"
  },
  "description": "Enhance your YouTube viewing experience, by sorting your open video tabs alphabetically, by channel name, view count or time.",
  "homepage_url": "https://github.com/bluecubesociety/youtube-sort",
  "manifest_version": 3,
  "name": "YouTube Sort",
  "short_name": "YouTube Sort",
  "permissions": ["tabs", "storage"],
  "version": "2.0",
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-48.png"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png"
  }
}
